# Google Ads API — Common
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-mcc-customer-id

# Google Ads API — Service Account Auth
# Create a service account in GCP, download the JSON key, and set the path below.
# If your Google Ads account is under a Google Workspace org, enable domain-wide
# delegation in GCP and set the email below to the Workspace user who owns/manages
# the Google Ads account. Not needed for personal Gmail accounts.
GOOGLE_ADS_SERVICE_ACCOUNT_PATH=~/.config/Google/your-service-account.json
GOOGLE_ADS_IMPERSONATED_EMAIL=user@yourdomain.com

# Optional: Default customer ID. If set, tools will use this when no customer_id
# is passed explicitly. Useful if you mostly work with a single account.
# You can always override per-call by passing customer_id to any tool.
# GOOGLE_ADS_CUSTOMER_ID=your-default-customer-id
